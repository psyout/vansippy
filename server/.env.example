PORT=8080
NODE_ENV=development
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/vansippy
CORS_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# For a simple setup, configure ADMIN_PASSWORD. For a hashed setup, omit it and use ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here
# Optional Hostinger-safe alternative: Base64-encode the bcrypt hash and omit ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH_B64=your_base64_encoded_bcrypt_hash_here
JWT_SECRET=replace_with_a_long_random_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
